##fileformat=VCFv4.2
##FILTER=<ID=PASS,Description="All filters passed">
##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">
##FORMAT=<ID=GQ,Number=1,Type=Integer,Description="Genotype Quality">
##FORMAT=<ID=DP,Number=1,Type=Integer,Description="Total read depth on the REF position">
##FORMAT=<ID=AD,Number=R,Type=Integer,Description="Allelic depth for each allele, in the order listed by GT">
##FORMAT=<ID=AF,Number=A,Type=Float,Description="Allele fraction for each allele, in the order listed by GT. Fraction of non-reference allele corresponds to the variant allele fraction(VAF)">
##FORMAT=<ID=CI,Number=1,Type=String,Description="95% confidence interval around the estimated allele fraction for the allele in the order listed by GT. format: ci_low,ci_up;ci_low,ci_up;...">
##FORMAT=<ID=AQ,Number=A,Type=Integer,Description="Allele quality, phred quality scores of pvalue of one-tail Fisher exact test to determine if the rate of allele is significantly greater than user defined cutoff (-j), in the order listed by GT. [CAUTION] In most cases, the minor allele corresponds to the heteroplasmic allele; therefore, the AQ at the minor allele position reflects the quality value of heterozygous allele mostly.">
##FORMAT=<ID=LAF,Number=A,Type=Float,Description="Transformed AF: The logit of the allele fraction (AF) is computed as logit(AF) = ln(AF/(1-AF)) for each allele, in the order listed by GT.">
##FORMAT=<ID=SB,Number=1,Type=String,Description="Allele-specific forward/reverse read counts for strand bias tests for the alleles, in the order listed by GT, separated by ';'. Format: fwd,rev;fwd,rev;...">
##FORMAT=<ID=FS,Number=A,Type=Float,Description="An ordered, comma delimited list of phred-scaled p-value using Fisher's exact test to detect strand bias">
##FORMAT=<ID=SOR,Number=A,Type=Float,Description="An ordered, comma delimited list of strand bias estimated by the Symmetric Odds Ratio test">
##FORMAT=<ID=VT,Number=1,Type=String,Description="An ordered, comma delimited list of variant type: REF, SNV, INS, DEL, or MNV">
##INFO=<ID=AN,Number=1,Type=Integer,Description="Number of samples with non-missing GT at this site">
##INFO=<ID=REF_N,Number=1,Type=Integer,Description="Total number of individuals exhibiting the reference state in the population.">
##INFO=<ID=HOM_N,Number=1,Type=Integer,Description="Total number of individuals exhibiting the homoplasmic state in the population.">
##INFO=<ID=HET_N,Number=1,Type=Integer,Description="Total number of individuals exhibiting the heteroplasmic state in the population.">
##INFO=<ID=DP_MEAN,Number=1,Type=Float,Description="Mean mitochondrial sequencing depth across samples contributing to AN">
##INFO=<ID=DP_MEDIAN,Number=1,Type=Integer,Description="Median mitochondrial sequencing depth across samples contributing to AN">
##INFO=<ID=VAF_MEAN,Number=A,Type=Float,Description="Mean mitochondrial variant allele fraction(VAF) across all samples contributing to AN, with VAF=0 assigned to samples without detectable variant">
##INFO=<ID=VAF_MEDIAN,Number=A,Type=Float,Description="Median mitochondrial VAF across all samples contributing to AN">
##INFO=<ID=VAF_MEAN_HET,Number=A,Type=Float,Description="Mean mitochondrial VAF among heteroplasmic samples only">
##INFO=<ID=VAF_MEDIAN_HET,Number=A,Type=Float,Description="Median mitochondrial VAF among heteroplasmic samples only">
##INFO=<ID=PT,Number=1,Type=String,Description="Type of plasmicity observed in population: Ref, Hom, Het, or Mixed(Hom and Het)">
##contig=<ID=chrM,length=16569,assembly=chrM_rCRS.decoy.fa.gz>
##contig=<ID=NUMT_JoinedSequences_gaps1000N_decoy,length=64266,assembly=chrM_rCRS.decoy.fa.gz>
##reference=file:///Users/huangshujia/Projects/mitoquest/tests/data/chrM_rCRS.decoy.fa.gz
##mitoquest_caller_command=caller -t 4 -f chrM_rCRS.decoy.fa.gz -Q 0 -r chrM -o tt smp1.cram smp2.cram smp3.cram
##INFO=<ID=trinucleotide,Number=A,Type=String,Description="Position to its reference trinucleotide">
##INFO=<ID=symbol,Number=A,Type=String,Description="Gene symbol">
##INFO=<ID=mitomap_locus,Number=A,Type=String,Description="Mitochondrial DNA Function Locations in MITOMAP: https://www.mitomap.org/foswiki/bin/view/MITOMAP/GenomeLoci">
##INFO=<ID=VEP_CSQ,Number=.,Type=String,Description="Consequence annotations of Ensembl VEP. Format: Allele|Consequence|IMPACT|SYMBOL|Gene|Feature_type|Feature|BIOTYPE|EXON|INTRON|HGVSc|HGVSp|cDNA_position|CDS_position|Protein_position|Amino_acids|Codons|Existing_variation|DISTANCE|STRAND|FLAGS|VARIANT_CLASS|SYMBOL_SOURCE|HGNC_ID|HGVS_OFFSET">
##INFO=<ID=gnomad_max_hl,Number=A,Type=String,Description="Maximum observed mtDNA heteroplasmy (max_hl) in gnomAD">
##INFO=<ID=gnomad_af_hom,Number=A,Type=String,Description="Observed homoplasmy allele frequence in gnomAD">
##INFO=<ID=gnomad_af_het,Number=A,Type=String,Description="Observed heteroplasmy allele frequence in gnomAD">
##INFO=<ID=gnomad_ac_hom,Number=A,Type=String,Description="Observed homoplasmy allele count in gnomAD">
##INFO=<ID=gnomad_ac_het,Number=A,Type=String,Description="Observed heteroplasmy allele count in gnomAD">
##INFO=<ID=in_phylotree,Number=A,Type=String,Description="phylotree variants">
##INFO=<ID=phyloP_score,Number=A,Type=String,Description="phyloP scores for conservation">
##INFO=<ID=tRNA_position,Number=A,Type=String,Description="The tRNA position numbers (ranging from 1-73) encoded by mtDNA">
##INFO=<ID=tRNA_domain,Number=A,Type=String,Description="Modified tRNA domains encoded by mtDNA">
##INFO=<ID=RNA_base_type,Number=A,Type=String,Description="RNA base types encoded by mtDNA (Watson-Crick (WC), non-WC, or loop/other)">
##INFO=<ID=RNA_modified,Number=A,Type=String,Description="Modified RNA bases encoded by mtDNA">
##INFO=<ID=rRNA_bridge_base,Number=A,Type=String,Description="It's rRNA bridge base or not">
##INFO=<ID=uniprot_annotation,Number=A,Type=String,Description="The UniProt annotations for mtDNA-encoded proteins">
##INFO=<ID=other_prot_annotation,Number=A,Type=String,Description="Residues involved in complex I proton transfer, curated from PMID:32972993">
##INFO=<ID=apogee_class,Number=A,Type=String,Description="The APOGEE scores for missense">
##INFO=<ID=mitotip_class,Number=A,Type=String,Description="The MitoTip in silico scores for tRNA variants">
##INFO=<ID=hmtvar_class,Number=A,Type=String,Description="The HmtVar in silico scores for tRNA variants">
##INFO=<ID=helix_max_hl,Number=A,Type=String,Description="Maximum observed heteroplasmy (max_hl) in HelixMTdb">
##INFO=<ID=helix_af_hom,Number=A,Type=String,Description="Observed homoplasmy allele frequence in HelixMTdb">
##INFO=<ID=helix_af_het,Number=A,Type=String,Description="Observed heteroplasmy allele frequence in HelixMTdb">
##INFO=<ID=mitomap_gbcnt,Number=A,Type=String,Description="Total number of gb sequences to convert to allele freq in MITOMAP">
##INFO=<ID=mitomap_af,Number=A,Type=String,Description="AF in MITOMAP">
##INFO=<ID=mitomap_status,Number=A,Type=String,Description="Disease association status for variant in MITOMAP">
##INFO=<ID=mitomap_plasmy,Number=A,Type=String,Description="Plasmy in MITOMAP">
##INFO=<ID=mitomap_disease,Number=A,Type=String,Description="Disease in MITOMAP">
##INFO=<ID=clinvar_interp,Number=A,Type=String,Description="The clinical significance interpretation for variant in ClinVar">
##INFO=<ID=chimp_ref,Number=A,Type=String,Description="The ancestral chimpanzee allele for thsi position">
##annotate_command=python ../../tools/mito_annotate.py -d /Users/huangshujia/Projects/mitoquest/data -i test2.vcf -o t.ann.txt -v t.ann.vcf
##FORMAT=<ID=PP,Number=1,Type=Float,Description="Posterior probability of true genotype">
##FORMAT=<ID=GOOD_CALL,Number=1,Type=String,Description="Good call (True=Good, False=bad)">
##FILTER=<ID=BLACKLISTED_SITE,Description="Site is in the blacklisted regions">
##FILTER=<ID=LOW_QUALITY,Description="Low quality site based on KL divergence from background noise distribution">
##QC_command=python ../../tools/mtDNA_variant_QC.py --vcf t.ann.vcf.gz --output test2.csv --output-vcf test2.vcf
